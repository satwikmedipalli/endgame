{
  "name": "endgame-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env --import tsx src/index.ts",
    "sync": "node --env-file=.env --import tsx src/index.ts --sync",
    "news": "node --env-file=.env --import tsx src/index.ts --news-preview",
    "test": "node --import tsx --test src/__tests__/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "fast-xml-parser": "^5.11.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
