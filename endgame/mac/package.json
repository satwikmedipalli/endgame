{
  "name": "endgame-mac",
  "productName": "Endgame",
  "version": "1.0.0",
  "description": "A daily feed that actually ends.",
  "author": "Satwik Medipalli",
  "private": true,
  "main": "dist/boot.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-main.mjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --mac --arm64",
    "install-app": "npm run dist && node scripts/install.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json"
  },
  "devDependencies": {
    "@fontsource/bricolage-grotesque": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/instrument-serif": "^5.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "chess.js": "^1.4.0",
    "electron": "45.3.4",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "fast-xml-parser": "^5.11.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~6.0.3",
    "vite": "^7.0.0"
  },
  "build": {
    "electronVersion": "45.3.4",
    "appId": "com.satwik.endgame",
    "productName": "Endgame",
    "copyright": "Satwik Medipalli",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.news",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "darkModeSupport": true,
      "extendInfo": {
        "LSUIElement": false,
        "NSHumanReadableCopyright": "A daily feed that actually ends."
      }
    }
  },
  "endgame": {
    "shell": 1,
    "updates": "satwikmedipalli/endgame, branch app-build (see src/main/updater.ts)"
  }
}
